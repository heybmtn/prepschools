# Copy to .env for local `astro dev`. Only PUBLIC_-prefixed vars reach the
# client bundle; everything else here is unused by the Vite dev server but
# listed for reference alongside .dev.vars.example (used by `wrangler pages dev`).
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
PUBLIC_WEBMCP_ENABLED=false

# Optional — only needed if you want Keystatic (at /keystatic in `npm run dev`)
# to save straight to GitHub instead of the local filesystem. Leave unset to
# use Keystatic with zero setup (edits write to src/content/**/*.mdx on disk).
# See README "Adding or editing a listing" for how to create the GitHub App.
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
