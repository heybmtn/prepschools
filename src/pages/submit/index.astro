---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { breadcrumbJsonLd } from "../../lib/jsonld";

const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Submit a School", url: "/submit/" },
];

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
---

<Base
  title="Submit a School"
  description="Add a UK preparatory school to the directory. Submissions are reviewed manually before publishing."
  jsonLd={breadcrumbJsonLd(breadcrumbItems)}
>
  <div class="wrap section submit-page">
    <Breadcrumbs items={breadcrumbItems} />
    <p class="eyebrow">Directory</p>
    <h1>Submit a school</h1>
    <p class="muted lede">
      Tell us about a school we should list. Every submission is reviewed by an editor before
      it goes live — nothing is published automatically.
    </p>

    <form id="submit-form" class="submit-form" novalidate>
      <div class="field">
        <label for="schoolName">School name</label>
        <input id="schoolName" name="schoolName" type="text" required />
      </div>

      <div class="field-row">
        <div class="field">
          <label for="town">Town</label>
          <input id="town" name="town" type="text" required />
        </div>
        <div class="field">
          <label for="county">County</label>
          <input id="county" name="county" type="text" required />
        </div>
      </div>

      <div class="field">
        <label for="website">Official website</label>
        <input id="website" name="website" type="url" placeholder="https://" required />
      </div>

      <div class="field-row">
        <div class="field">
          <label for="ageRange">Age range</label>
          <input id="ageRange" name="ageRange" type="text" placeholder="e.g. 4–13" required />
        </div>
        <div class="field">
          <label for="gender">Gender</label>
          <select id="gender" name="gender" required>
            <option value="co-ed">Co-ed</option>
            <option value="boys">Boys</option>
            <option value="girls">Girls</option>
          </select>
        </div>
        <div class="field">
          <label for="boarding">Day / boarding</label>
          <select id="boarding" name="boarding" required>
            <option value="day">Day only</option>
            <option value="boarding">Boarding only</option>
            <option value="day-and-boarding">Day & boarding</option>
          </select>
        </div>
      </div>

      <div class="field">
        <label for="description">Short description</label>
        <textarea id="description" name="description" rows="3" maxlength="400" required></textarea>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="submitterName">Your name</label>
          <input id="submitterName" name="submitterName" type="text" required />
        </div>
        <div class="field">
          <label for="submitterEmail">Your email</label>
          <input id="submitterEmail" name="submitterEmail" type="email" required />
        </div>
      </div>

      <!-- Honeypot: hidden from real users, bots tend to fill every field -->
      <div class="field honeypot" aria-hidden="true">
        <label for="companyWebsite">Leave this field blank</label>
        <input id="companyWebsite" name="companyWebsite" type="text" tabindex="-1" autocomplete="off" />
      </div>

      {turnstileSiteKey && (
        <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-callback="onTurnstileSuccess"></div>
      )}

      <button type="submit" class="btn btn-primary submit-btn" id="submit-btn">Submit school</button>

      <p id="form-status" class="form-status muted" role="status"></p>
    </form>
  </div>
</Base>

{turnstileSiteKey && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script>
  const form = document.getElementById("submit-form") as HTMLFormElement;
  const status = document.getElementById("form-status") as HTMLElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  let turnstileToken = "";

  (window as any).onTurnstileSuccess = (token: string) => {
    turnstileToken = token;
  };

  form.addEventListener("submit", async (event) => {
    event.preventDefault();

    const turnstileInput = form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]');
    const token = turnstileInput?.value || turnstileToken;

    const data = Object.fromEntries(new FormData(form).entries());

    submitBtn.disabled = true;
    status.textContent = "Sending…";

    try {
      const res = await fetch("/api/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ ...data, turnstileToken: token }),
      });

      const result = (await res.json().catch(() => ({ ok: false }))) as { ok: boolean; error?: string };

      if (res.ok && result.ok) {
        form.hidden = true;
        status.textContent = "Thanks — your submission has been received and will be reviewed by an editor shortly.";
        status.classList.add("form-status-success");
      } else {
        status.textContent = result.error || "Something went wrong. Please try again.";
        submitBtn.disabled = false;
      }
    } catch {
      status.textContent = "Something went wrong. Please check your connection and try again.";
      submitBtn.disabled = false;
    }
  });
</script>

<style>
  .submit-page {
    max-width: 680px;
  }

  .lede {
    font-size: 1.1rem;
  }

  .submit-form {
    margin-top: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    flex: 1;
  }

  .field-row {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .field label {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .field input,
  .field select,
  .field textarea {
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--color-text);
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: 2px solid var(--color-teal);
    outline-offset: 1px;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .submit-btn {
    align-self: flex-start;
  }

  .form-status {
    min-height: 1.4em;
    font-size: 0.9rem;
  }

  .form-status-success {
    color: var(--color-teal-dark);
    font-weight: 600;
  }
</style>
