---
import { NAV, SITE } from "../lib/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <p class="wordmark"><span class="wordmark-mark">UK</span> Prep Schools</p>
      <p class="muted footer-desc">{SITE.description}</p>
    </div>
    <nav class="footer-nav" aria-label="Footer">
      <div>
        <p class="footer-heading">Directory</p>
        <ul>
          <li><a href="/prep-schools/">Browse all schools</a></li>
          <li><a href="/england/">England</a></li>
          <li><a href="/scotland/">Scotland</a></li>
          <li><a href="/wales/">Wales</a></li>
        </ul>
      </div>
      <div>
        <p class="footer-heading">Site</p>
        <ul>
          {NAV.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
      <div>
        <p class="footer-heading">For machines</p>
        <ul>
          <li><a href="/llms.txt">llms.txt</a></li>
          <li><a href="/sitemap-index.xml">Sitemap</a></li>
          <li><a href="/blog/rss.xml">Blog RSS</a></li>
        </ul>
      </div>
    </nav>
  </div>
  <div class="wrap footer-bottom">
    <p class="muted">&copy; {year} UK Prep Schools. Independent directory — not affiliated with any school listed.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-24);
    padding-top: var(--space-16);
    background: var(--color-surface);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.4fr 2fr;
    gap: var(--space-12);
    padding-bottom: var(--space-12);
  }

  .footer-desc {
    max-width: 34ch;
    font-size: 0.95rem;
  }

  .wordmark {
    font-weight: 800;
    font-size: 1.1rem;
    margin: 0 0 var(--space-2);
  }

  .wordmark-mark {
    color: var(--color-teal);
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .footer-heading {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-3);
  }

  .footer-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-nav a {
    font-size: 0.92rem;
    color: var(--color-text);
  }

  .footer-nav a:hover {
    color: var(--color-teal);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-6);
    font-size: 0.85rem;
  }

  @media (max-width: 720px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
    .footer-nav {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
    }
  }

  @media (max-width: 520px) {
    .footer-nav {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
